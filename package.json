{
  "name": "gym-hipertrofia-tracker",
  "version": "1.0.0",
  "description": "App personal para administrar rutinas de entrenamiento con variaciones semanales. IndexedDB local + Google Drive sync.",
  "author": "Andrés Morales",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 8000",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:mobile": "playwright test --project=iphone-14-chromium",
    "test:safari": "cross-env WEBKIT=1 playwright test --project=iphone-14-safari",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Build coming soon'"
  },
  "keywords": [
    "gym",
    "fitness",
    "hipertrofia",
    "tracker",
    "indexeddb",
    "google-drive"
  ],
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "http-server": "^14.1.1",
    "typescript": "^5.6.3"
  }
}
