# ⚙️ CONFIGURACIÓN - COPIAR A .env.local Y COMPLETAR

# 🔐 Google OAuth 2.0 Credentials
# Obtener desde: https://console.cloud.google.com/
# 1. Crear proyecto nuevo
# 2. Habilitar Google Drive API
# 3. Crear credencial OAuth 2.0 (Aplicación web)
# 4. Agregar http://localhost:8000 como origen autorizado
# 5. Copiar el Client ID aquí

VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# 📱 App Settings
VITE_TRAINING_START=05:00
VITE_TRAINING_DURATION_MIN=90
VITE_SYNC_INTERVAL_MS=300000

# ⚠️ IMPORTANTE
# - NO COMMITEAR .env.local con credenciales reales
# - Solo usar para desarrollo local
# - En producción, usar variables de entorno del servidor
